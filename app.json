{
  "expo": {
    "name": "ChitChat",
    "slug": "chitchat",
    "scheme": "chitchat",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "in.skmohammadali.chitchat",
      "adaptiveIcon": {
        "backgroundColor": "#10131B"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.skmohammadali.chitchat"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {},
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
