{
  "name": "chitchat",
  "version": "0.2.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test:rust": "cargo test --workspace",
    "build:rust:android": "cargo build --manifest-path rust/chitchat-core/Cargo.toml --target aarch64-linux-android --release",
    "build:rust:ios": "cargo build --manifest-path rust/chitchat-core/Cargo.toml --target aarch64-apple-ios --release",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format:rust": "cargo fmt --all -- --check",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:both": "eas build --platform all --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@supabase/supabase-js": "2.119.0",
    "expo": "~58.0.23",
    "expo-linking": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-url-polyfill": "4.0.0",
    "expo-secure-store": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-local-authentication": "~58.0.3",
    "expo-network": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-audio": "~58.0.12",
    "expo-chitchat-core": "file:./modules/chitchat-core"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
